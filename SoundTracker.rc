#include <windows.h>
#include "resource.h"
#include "include/Version.h"

IDI_APP_ICON ICON "resources/app.ico"

// Embedded application manifest (asInvoker, common controls v6, Windows 10/11).
// Embedded here rather than by the linker so MSVC and MinGW builds match.
1 24 "SoundTracker.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     APP_VERSION_MAJOR,APP_VERSION_MINOR,APP_VERSION_PATCH,0
PRODUCTVERSION  APP_VERSION_MAJOR,APP_VERSION_MINOR,APP_VERSION_PATCH,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "IronAdamant"
            VALUE "FileDescription", "Windows Sound Tracker"
            VALUE "FileVersion", APP_VERSION_STR
            VALUE "InternalName", "SoundTracker"
            VALUE "LegalCopyright", "Copyright (C) 2025-2026 IronAdamant. MIT License."
            VALUE "OriginalFilename", "SoundTracker.exe"
            VALUE "ProductName", "Windows Sound Tracker"
            VALUE "ProductVersion", APP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
